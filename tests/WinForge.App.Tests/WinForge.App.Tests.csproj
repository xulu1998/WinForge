<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- WPF/XAML regression tests must execute synchronously on a dedicated STA
         thread (RunSta). When a test also needs an async discovery pass, the only
         safe way to block is .GetAwaiter().GetResult() inside that STA action.
         xUnit1031 (avoid blocking task calls in tests) is therefore suppressed for
         this project: the alternative (a real async test on xUnit's MTA thread)
         cannot host WPF's Application/Dispatcher. -->
    <NoWarn>$(NoWarn);xUnit1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WinForge.App\WinForge.App.csproj" />
    <ProjectReference Include="..\..\src\WinForge.Core\WinForge.Core.csproj" />
    <ProjectReference Include="..\..\src\WinForge.Infrastructure\WinForge.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Phase 14.3 real-derived regression fixture (tests/fixtures). Copied to the
       test output so the fixture validation test can read it. -->
  <ItemGroup>
    <None Include="..\fixtures\25H2-Pro-zhCN-component-families.json"
          CopyToOutputDirectory="PreserveNewest"
          Link="fixtures\25H2-Pro-zhCN-component-families.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
