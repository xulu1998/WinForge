<Window x:Class="WinForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinForge.App.ViewModels"
        xmlns:conv="clr-namespace:WinForge.App.Converters"
        Title="WinForge"
        Width="1180" Height="760" MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF">
    <Window.Resources>
        <Style x:Key="RailButton" TargetType="Button">
            <Setter Property="Background" Value="#1F2933"/>
            <Setter Property="Foreground" Value="#CBD2D9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,3"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="#3B82F6"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WorkflowRailButton" TargetType="Button" BasedOn="{StaticResource RailButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWorkflowActive}" Value="True">
                    <Setter Property="Background" Value="#3B82F6"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Left" Width="210" Background="#1F2933">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,20,18,6">
                    <TextBlock Text="WinForge" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Foreground="#9AA5B1" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Source="Home.Subtitle"/>
                                <Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Margin="8,4,8,4">
                    <Button Style="{StaticResource WorkflowRailButton}" Command="{Binding ShowWorkflowCommand}">
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource locKey}">
                                    <Binding Source="Nav.Workflow"/>
                                    <Binding Source="{StaticResource Loc}"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Button>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding UtilityItems}" Margin="8,4,8,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavItem}">
                            <Button Style="{StaticResource RailButton}" Command="{Binding Command}">
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource locKey}">
                                            <Binding Path="Title"/>
                                            <Binding Source="{StaticResource Loc}"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
        <ContentControl Content="{Binding ActiveView}"/>
    </DockPanel>
</Window>
