<Application x:Class="WinForge.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinForge.App.ViewModels"
             xmlns:wf="clr-namespace:WinForge.App.Workflow"
             xmlns:views="clr-namespace:WinForge.App.Views"
             xmlns:conv="clr-namespace:WinForge.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
                    <conv:NullToVisibilityConverter x:Key="NullToVis"/>
                    <conv:StringNullOrEmptyToVisibilityConverter x:Key="NullEmptyToVis"/>
                    <conv:BooleanToVisibilityInverseConverter x:Key="BoolToVisInv"/>
                    <conv:BooleanToFontWeightConverter x:Key="BoolToBold"/>

                    <!-- Localization-aware converters (refresh on language switch) -->
                    <conv:LocKeyMultiConverter x:Key="locKey"/>
                    <conv:StateToCaptionConverter x:Key="stateCaption"/>
                    <conv:StepBadgeConverter x:Key="stepBadge"/>
                    <conv:RecommendationToColorConverter x:Key="recColor"/>
                    <conv:RiskToColorConverter x:Key="riskColor"/>

                    <Style x:Key="StatusTile" TargetType="Border">
                        <Setter Property="Background" Value="#F5F7FA"/>
                        <Setter Property="BorderBrush" Value="#E4E7EB"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="CornerRadius" Value="6"/>
                        <Setter Property="Padding" Value="16"/>
                        <Setter Property="Width" Value="180"/>
                        <Setter Property="Margin" Value="0,0,12,12"/>
                    </Style>

                    <Style x:Key="FieldLabel" TargetType="TextBlock">
                        <Setter Property="Width" Value="150"/>
                        <Setter Property="Foreground" Value="#7B8794"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>

                    <Style x:Key="PrimaryButton" TargetType="Button">
                        <Setter Property="Background" Value="#3B82F6"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="14,8"/>
                        <Setter Property="FontSize" Value="13"/>
                    </Style>

                    <Style x:Key="StepButton" TargetType="Button">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="#CBD2D9"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="Margin" Value="0,0,8,0"/>
                        <Setter Property="MinWidth" Value="120"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="Foreground" Value="#1F2933"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Current">
                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="Background" Value="#EAF2FE"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="NotAvailable">
                                <Setter Property="Opacity" Value="0.55"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Completed">
                                <Setter Property="BorderBrush" Value="#2F855A"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <!-- Step content templates (referenced by WizardStepTemplateSelector) -->
            <DataTemplate x:Key="SourceStepTemplate">
                <views:SourceView DataContext="{Binding Content}"/>
            </DataTemplate>
            <DataTemplate x:Key="PrepareStepTemplate">
                <views:PrepareView DataContext="{Binding Content}"/>
            </DataTemplate>
            <DataTemplate x:Key="CustomizeStepTemplate">
                <views:CustomizeView DataContext="{Binding Content}"/>
            </DataTemplate>
            <DataTemplate x:Key="ReviewStepTemplate">
                <views:PlanReviewView DataContext="{Binding Content}"/>
            </DataTemplate>
            <DataTemplate x:Key="ApplyStepTemplate">
                <views:ApplyView DataContext="{Binding Content}"/>
            </DataTemplate>
            <DataTemplate x:Key="BuildStepTemplate">
                <views:BuildView DataContext="{Binding Content}"/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <views:HomeView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LogsViewModel}">
                <views:LogsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ComponentsViewModel}">
                <views:ComponentsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ComponentListTabViewModel}">
                <views:ComponentListTabView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PrivacyViewModel}">
                <views:PrivacyView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SystemViewModel}">
                <views:SystemView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlanReviewViewModel}">
                <views:PlanReviewView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ComingSoonViewModel}">
                <views:ComingSoonView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type wf:WorkflowViewModel}">
                <views:WizardView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AboutViewModel}">
                <views:AboutView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ComponentIntelligenceViewModel}">
                <views:ComponentIntelligenceView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ComponentKnowledgeViewModel}">
                <views:ComponentKnowledgeView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:OptimizationKnowledgeViewModel}">
                <views:OptimizationKnowledgeView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
                <views:ProfileView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
