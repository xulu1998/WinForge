<UserControl x:Class="WinForge.App.Views.PrepareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:WinForge.App.ViewModels"
             xmlns:conv="clr-namespace:WinForge.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ImageViewModel}">
    <ScrollViewer Padding="32">
        <StackPanel MaxWidth="820">
            <TextBlock FontSize="24" FontWeight="Bold" Foreground="#1F2933">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource locKey}">
                        <Binding Source="Prepare.Heading"/>
                        <Binding Source="{StaticResource Loc}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <TextBlock FontSize="12" Foreground="#7B8794" Margin="0,4,0,0" TextWrapping="Wrap">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource locKey}">
                        <Binding Source="Prepare.Note"/><Binding Source="{StaticResource Loc}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Background="#2F855A"
                        Command="{Binding PrepareWorkingImageCommand}"
                        Visibility="{Binding CanPrepareWorkingImage, Converter={StaticResource BoolToVis}}">
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Source="Source.Prepare"/><Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Background="#487EB0"
                        Command="{Binding MountWorkingImageCommand}"
                        Visibility="{Binding CanMountWorkingImage, Converter={StaticResource BoolToVis}}">
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Source="Source.Mount"/><Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Background="#9B1C1C"
                        Command="{Binding UnmountDiscardCommand}"
                        Visibility="{Binding CanUnmountDiscard, Converter={StaticResource BoolToVis}}">
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Source="Source.Unmount"/><Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Button>
            </StackPanel>

            <TextBlock FontSize="13" Foreground="#3B82F6" Margin="0,8,0,0" TextWrapping="Wrap"
                       Visibility="{Binding IsServicing, Converter={StaticResource BoolToVis}}"
                       Text="{Binding ServicingMessage}"/>
            <TextBlock FontSize="13" Foreground="#9B1C1C" Margin="0,8,0,0" TextWrapping="Wrap"
                       Visibility="{Binding BlockedMessage, Converter={StaticResource NullToVis}}"
                       Text="{Binding BlockedMessage}"/>

            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#1F2933" Margin="0,24,0,0">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource locKey}">
                        <Binding Source="Source.WorkingImage"/><Binding Source="{StaticResource Loc}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <StackPanel Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Source="Source.ServicingStatus"/><Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding ServicingStatusDisplay}" FontSize="13" VerticalAlignment="Center"
                               FontWeight="{Binding IsServicingMounted, Converter={StaticResource BoolToBold}}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Source="Source.SourceEdition"/><Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding ServicingSourceEditionDisplay}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Source="Source.SourceIndex"/><Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding ServicingSourceIndexDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Source="Source.WorkingImage"/><Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding ServicingWorkingImageDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Source="Source.WorkingIndex"/><Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding ServicingWorkingIndexDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Source="Source.WorkingDirectory"/><Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding ServicingWorkingDirectoryDisplay}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Source="Source.MountDirectory"/><Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding ServicingMountDirectoryDisplay}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock FontSize="12" Foreground="#9B1C1C" Margin="0,4,0,0" TextWrapping="Wrap"
                           Visibility="{Binding ServicingErrorDisplay, Converter={StaticResource NullToVis}}"
                           Text="{Binding ServicingErrorDisplay}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
