<UserControl x:Class="WinForge.App.Views.CustomizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:WinForge.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CustomizeStepViewModel}">
    <!--
        Stage 11.4 final layout: header rows are Auto and the TabControl takes the
        star height, so the component list is the PRIMARY work surface. Selecting a
        profile immediately applies its safe recommendations (final flow — no
        separate adopt button). The recommendation detail opens as an OVERLAY over
        the Customize surface with an explicit close/back action, so the user is
        never trapped and the tabs/list stay logically intact.
    -->
    <Grid Margin="16,10,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Compact page title -->
        <TextBlock Grid.Row="0" FontSize="20" FontWeight="Bold" Foreground="#1F2933">
            <TextBlock.Text>
                <MultiBinding Converter="{StaticResource locKey}">
                    <Binding Source="Step.Customize.Title"/><Binding Source="{StaticResource Loc}"/>
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>

        <!-- Compact subtitle -->
        <TextBlock Grid.Row="1" FontSize="11.5" Foreground="#7B8794" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="900">
            <TextBlock.Text>
                <MultiBinding Converter="{StaticResource locKey}">
                    <Binding Source="Step.Customize.Description"/><Binding Source="{StaticResource Loc}"/>
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>

        <!-- Scan + selected-count share ONE compact row -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Style="{StaticResource PrimaryButton}" Background="#2F855A"
                    Padding="12,5"
                    Command="{Binding DiscoverCommand, Mode=OneWay}">
                <TextBlock FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource locKey}">
                                        <Binding Source="Customize.Discover"/><Binding Source="{StaticResource Loc}"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <!-- Once discovery completed, the button becomes 重新扫描 -->
                                <DataTrigger Binding="{Binding Components.HasInventory, Mode=OneWay}" Value="True">
                                    <Setter Property="Text">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource locKey}">
                                                <Binding Source="Customize.Rescan"/><Binding Source="{StaticResource Loc}"/>
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>
            <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#3B82F6" FontSize="12"
                       Visibility="{Binding IsDiscovering, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource locKey}">
                        <Binding Source="Customize.Discovering"/><Binding Source="{StaticResource Loc}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#2F855A" FontSize="12" FontWeight="SemiBold"
                       Visibility="{Binding Components.HasInventory, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Run>
                    <Run.Text>
                        <MultiBinding Converter="{StaticResource locKey}">
                            <Binding Mode="OneWay" Source="Customize.Selected"/><Binding Mode="OneWay" Source="{StaticResource Loc}"/>
                        </MultiBinding>
                    </Run.Text>
                </Run>
                <Run Text=" "/>
                <Run Text="{Binding SelectedTotal, Mode=OneWay}"/>
                <Run>
                    <Run.Text>
                        <MultiBinding Converter="{StaticResource locKey}">
                            <Binding Mode="OneWay" Source="Customize.SelectedItems"/><Binding Mode="OneWay" Source="{StaticResource Loc}"/>
                        </MultiBinding>
                    </Run.Text>
                </Run>
            </TextBlock>
        </StackPanel>

        <!-- Stage 11.4 — recommended configuration selector (collapsed when not wired) -->
        <ContentControl Grid.Row="3" Content="{Binding Profiles, Mode=OneWay}"
                        Visibility="{Binding Profiles, Mode=OneWay, Converter={StaticResource NullToVis}}"/>

        <!-- Star row: tabs/list + recommendation-detail overlay on top -->
        <Grid Grid.Row="4" Margin="0,10,0,12">
            <TabControl ItemsSource="{Binding Tabs}"
                        SelectedItem="{Binding SelectedTab, Mode=TwoWay}">
                <TabControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CustomizeTabViewModel}">
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource locKey}">
                                    <Binding Path="HeaderKey"/><Binding Source="{StaticResource Loc}"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type vm:CustomizeTabViewModel}">
                        <ContentControl Content="{Binding Content}" Margin="10"/>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <!-- Recommendation detail overlay (final flow): explicit close returns
                 to the EXACT same Customize state — tabs, selections, profile kept -->
            <Grid Panel.ZIndex="10"
                  Background="#99000000"
                  Visibility="{Binding Profiles.IsPreviewOpen, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Border Background="White" BorderBrush="#CBD2D9" BorderThickness="1" CornerRadius="6"
                        Margin="24,10" MaxWidth="1000" MaxHeight="640"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="16,12,16,6">
                            <Button DockPanel.Dock="Right" Margin="0,0,0,0" Padding="10,5"
                                    Background="Transparent" BorderThickness="0" FontSize="13"
                                    Foreground="#3B82F6" VerticalAlignment="Center"
                                    Command="{Binding Profiles.ClosePreviewCommand, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="× " FontSize="16" FontWeight="Bold"/>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource locKey}">
                                                <Binding Source="Profile.BackToCustomize"/><Binding Source="{StaticResource Loc}"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#1F2933" VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource locKey}">
                                        <Binding Source="Profile.Details"/><Binding Source="{StaticResource Loc}"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DockPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Profiles.PreviewGroups, Mode=OneWay}" Margin="16,4,16,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RecommendationPreviewGroup}">
                                        <StackPanel Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#1F2933">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource locKey}">
                                                            <Binding Path="HeaderKey" Mode="OneWay"/><Binding Source="{StaticResource Loc}" Mode="OneWay"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock FontSize="12" Foreground="#7B8794" Margin="10,0,0,0"
                                                           Text="{Binding TabBreakdown, Mode=OneWay}"/>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Items, Mode=OneWay}" Margin="14,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:RecommendationPreviewItem}">
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock FontSize="12" Foreground="#1F2933"
                                                                       Text="{Binding DisplayName, Mode=OneWay}" MinWidth="240"/>
                                                            <TextBlock FontSize="12" Foreground="#2F855A"
                                                                       Text="{Binding Caption, Mode=OneWay}" MinWidth="110"/>
                                                            <TextBlock FontSize="11" Foreground="#7B8794" TextWrapping="Wrap"
                                                                       MaxWidth="480" Text="{Binding ReasonText, Mode=OneWay}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
