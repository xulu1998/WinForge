<UserControl x:Class="WinForge.App.Views.CustomizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:WinForge.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CustomizeStepViewModel}">
    <!--
        Stage 11.4 final layout (approved compact Customize):
        header rows are Auto and the TabControl takes the star height, so the
        component list is the PRIMARY work surface and always consumes the
        majority of the viewport. Header (title + subtitle + scan/selected) is
        one compact block (Part A/F/J).
    -->
    <Grid Margin="16,10,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Compact page title -->
        <TextBlock Grid.Row="0" FontSize="20" FontWeight="Bold" Foreground="#1F2933">
            <TextBlock.Text>
                <MultiBinding Converter="{StaticResource locKey}">
                    <Binding Source="Step.Customize.Title"/><Binding Source="{StaticResource Loc}"/>
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>

        <!-- Compact subtitle -->
        <TextBlock Grid.Row="1" FontSize="11.5" Foreground="#7B8794" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="900">
            <TextBlock.Text>
                <MultiBinding Converter="{StaticResource locKey}">
                    <Binding Source="Step.Customize.Description"/><Binding Source="{StaticResource Loc}"/>
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>

        <!-- Scan + selected-count share ONE compact row (no separate large row) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Style="{StaticResource PrimaryButton}" Background="#2F855A"
                    Padding="12,5"
                    Command="{Binding DiscoverCommand, Mode=OneWay}">
                <TextBlock FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource locKey}">
                                        <Binding Source="Customize.Discover"/><Binding Source="{StaticResource Loc}"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <!-- Once discovery completed, the button becomes 重新扫描 -->
                                <DataTrigger Binding="{Binding Components.HasInventory, Mode=OneWay}" Value="True">
                                    <Setter Property="Text">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource locKey}">
                                                <Binding Source="Customize.Rescan"/><Binding Source="{StaticResource Loc}"/>
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>
            <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#3B82F6" FontSize="12"
                       Visibility="{Binding IsDiscovering, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource locKey}">
                        <Binding Source="Customize.Discovering"/><Binding Source="{StaticResource Loc}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#2F855A" FontSize="12" FontWeight="SemiBold"
                       Visibility="{Binding Components.HasInventory, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Run>
                    <Run.Text>
                        <MultiBinding Converter="{StaticResource locKey}">
                            <Binding Mode="OneWay" Source="Customize.Selected"/><Binding Mode="OneWay" Source="{StaticResource Loc}"/>
                        </MultiBinding>
                    </Run.Text>
                </Run>
                <Run Text=" "/>
                <Run Text="{Binding Components.SelectedTotal, Mode=OneWay}"/>
                <Run>
                    <Run.Text>
                        <MultiBinding Converter="{StaticResource locKey}">
                            <Binding Mode="OneWay" Source="Customize.SelectedItems"/><Binding Mode="OneWay" Source="{StaticResource Loc}"/>
                        </MultiBinding>
                    </Run.Text>
                </Run>
            </TextBlock>
        </StackPanel>

        <!-- Stage 11.4 — recommended configuration selector (collapsed when not wired) -->
        <ContentControl Grid.Row="3" Content="{Binding Profiles, Mode=OneWay}"
                        Visibility="{Binding Profiles, Mode=OneWay, Converter={StaticResource NullToVis}}"/>

        <!-- Star row: the tab control consumes ALL remaining height -->
        <TabControl Grid.Row="4" ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                    Margin="0,10,0,12">
            <TabControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:CustomizeTabViewModel}">
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Path="HeaderKey"/><Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:CustomizeTabViewModel}">
                    <ContentControl Content="{Binding Content}" Margin="10"/>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </Grid>
</UserControl>
