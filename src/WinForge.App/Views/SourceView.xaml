<UserControl x:Class="WinForge.App.Views.SourceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:WinForge.App.ViewModels"
             xmlns:conv="clr-namespace:WinForge.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ImageViewModel}">
    <ScrollViewer Padding="32">
        <StackPanel MaxWidth="820">
            <TextBlock FontSize="24" FontWeight="Bold" Foreground="#1F2933">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource locKey}">
                        <Binding Source="Home.SourceImage"/>
                        <Binding Source="{StaticResource Loc}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <TextBox Text="{Binding FileDisplay, Mode=OneWay}" IsReadOnly="True" Width="440" Padding="8"
                         VerticalContentAlignment="Center" BorderBrush="#CBD2D9"/>
                <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                        Command="{Binding SelectIsoCommand}">
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Source="Source.SelectIso"/>
                                <Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Background="#487EB0"
                        Command="{Binding InspectIsoCommand}">
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Source="Source.Inspect"/>
                                <Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Button>
            </StackPanel>

            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#1F2933" Margin="0,24,0,0">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource locKey}">
                        <Binding Source="Source.Inspection"/>
                        <Binding Source="{StaticResource Loc}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <TextBlock Foreground="#3B82F6" FontSize="13" Margin="0,8,0,0"
                       Visibility="{Binding IsInspecting, Converter={StaticResource BoolToVis}}">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource locKey}">
                        <Binding Source="Source.Inspecting"/>
                        <Binding Source="{StaticResource Loc}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <TextBlock FontSize="13" Foreground="#9B1C1C" Margin="0,8,0,0" TextWrapping="Wrap"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                       Text="{Binding StatusMessage}"/>

            <StackPanel Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Source="Source.FileName"/><Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding FileNameDisplay}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Source="Source.Size"/><Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding SizeDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Source="Source.Detection"/><Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding DetectedTypeDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Source="Source.InstallImage"/><Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding InstallImageDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#1F2933" Margin="0,24,0,0">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource locKey}">
                        <Binding Source="Source.WindowsInfo"/>
                        <Binding Source="{StaticResource Loc}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <StackPanel Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Source="Source.Version"/><Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding WindowsVersionDisplay}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Source="Source.Build"/><Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding BuildDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Source="Source.Architecture"/><Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding ArchitectureDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Source="Source.Language"/><Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding LanguagesDisplay}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>

            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#1F2933" Margin="0,24,0,0">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource locKey}">
                        <Binding Source="Source.Editions"/><Binding Source="{StaticResource Loc}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <ListView ItemsSource="{Binding Editions}"
                      SelectedItem="{Binding SelectedEdition, Mode=TwoWay}"
                      MaxHeight="340" Margin="0,8,0,0"
                      BorderBrush="#CBD2D9" BorderThickness="1">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4">
                            <TextBlock Text="{Binding Index}" FontWeight="SemiBold" Width="30"/>
                            <TextBlock Text="{Binding Name}" Width="260" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Architecture}" Foreground="#52606D"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock FontSize="12" Foreground="#7B8794" Margin="0,8,0,0" TextWrapping="Wrap">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource locKey}">
                        <Binding Source="Source.SelectEditionHint"/><Binding Source="{StaticResource Loc}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#1F2933" Margin="0,24,0,0">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource locKey}">
                        <Binding Source="Source.SelectedImage"/><Binding Source="{StaticResource Loc}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <StackPanel Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Source="Source.Status"/><Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding WorkspaceStatusDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Source="Source.Edition"/><Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding WorkspaceEditionDisplay}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Source="Source.Index"/><Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding WorkspaceIndexDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Source="Source.Image"/><Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding WorkspaceImageDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Source="Source.Architecture"/><Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding WorkspaceArchitectureDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Source="Source.Build"/><Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding WorkspaceBuildDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Source="Source.Source"/><Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding WorkspaceSourceDisplay}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>
            <TextBlock FontSize="12" Foreground="#7B8794" Margin="0,8,0,0" TextWrapping="Wrap">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource locKey}">
                        <Binding Source="Source.WorkspaceNote"/><Binding Source="{StaticResource Loc}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
