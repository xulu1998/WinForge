<UserControl x:Class="WinForge.App.Views.PlanReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:WinForge.App.ViewModels"
             xmlns:conv="clr-namespace:WinForge.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PlanReviewViewModel}">
    <ScrollViewer Padding="32">
        <StackPanel MaxWidth="900">
            <TextBlock FontSize="24" FontWeight="Bold" Foreground="#1F2933">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource locKey}">
                        <Binding Mode="OneWay" Source="Review.PageTitle"/><Binding Mode="OneWay" Source="{StaticResource Loc}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <TextBlock FontSize="12" Foreground="#7B8794" Margin="0,4,0,0" TextWrapping="Wrap">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource locKey}">
                        <Binding Mode="OneWay" Source="Review.Intro"/><Binding Mode="OneWay" Source="{StaticResource Loc}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <Border Style="{StaticResource StatusTile}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#1F2933">
                        <Run>
                            <Run.Text>
                                <MultiBinding Converter="{StaticResource locKey}">
                                    <Binding Mode="OneWay" Source="Review.Total"/><Binding Mode="OneWay" Source="{StaticResource Loc}"/>
                                </MultiBinding>
                            </Run.Text>
                        </Run>
                        <Run Text=" "/>
                        <Run Text="{Binding TotalSelected, Mode=OneWay}"/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Margin="0,0,16,0" Foreground="#52606D">
                            <Run>
                                <Run.Text>
                                    <MultiBinding Converter="{StaticResource locKey}">
                                        <Binding Mode="OneWay" Source="Review.Apps"/><Binding Mode="OneWay" Source="{StaticResource Loc}"/>
                                    </MultiBinding>
                                </Run.Text>
                            </Run>
                            <Run Text=" "/>
                            <Run Text="{Binding TotalApps, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Margin="0,0,16,0" Foreground="#52606D">
                            <Run>
                                <Run.Text>
                                    <MultiBinding Converter="{StaticResource locKey}">
                                        <Binding Mode="OneWay" Source="Review.Packages"/><Binding Mode="OneWay" Source="{StaticResource Loc}"/>
                                    </MultiBinding>
                                </Run.Text>
                            </Run>
                            <Run Text=" "/>
                            <Run Text="{Binding TotalPackages, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Margin="0,0,16,0" Foreground="#52606D">
                            <Run>
                                <Run.Text>
                                    <MultiBinding Converter="{StaticResource locKey}">
                                        <Binding Mode="OneWay" Source="Review.Registry"/><Binding Mode="OneWay" Source="{StaticResource Loc}"/>
                                    </MultiBinding>
                                </Run.Text>
                            </Run>
                            <Run Text=" "/>
                            <Run Text="{Binding TotalRegistry, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Foreground="#52606D">
                            <Run>
                                <Run.Text>
                                    <MultiBinding Converter="{StaticResource locKey}">
                                        <Binding Mode="OneWay" Source="Review.Services"/><Binding Mode="OneWay" Source="{StaticResource Loc}"/>
                                    </MultiBinding>
                                </Run.Text>
                            </Run>
                            <Run Text=" "/>
                            <Run Text="{Binding TotalServices, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#1F2933" Margin="0,16,0,0">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource locKey}">
                        <Binding Mode="OneWay" Source="Plan.Ops"/><Binding Mode="OneWay" Source="{StaticResource Loc}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <TextBlock FontSize="12" Foreground="#7B8794" Margin="0,2,0,0" TextWrapping="Wrap">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource locKey}">
                        <Binding Mode="OneWay" Source="Plan.Empty"/><Binding Mode="OneWay" Source="{StaticResource Loc}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <!-- Stage 11.3: every selected change is listed with its exact ACTION
                 TYPE (移除/禁用/配置/服务/功能), offline scope, and revert contract,
                 so the user knows exactly what will happen before Apply (Part S). -->
            <ListView ItemsSource="{Binding Operations, Mode=OneWay}" BorderBrush="#CBD2D9"
                      BorderThickness="1" Margin="0,8,0,0"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ReviewOperationItem}">
                        <Grid Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#487EB0" Padding="6,2" CornerRadius="3"
                                    VerticalAlignment="Center">
                                <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold"
                                           Text="{Binding ActionCaption, Mode=OneWay}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName, Mode=OneWay}"/>
                                <TextBlock FontSize="11" Foreground="#9AA5B1" Text="{Binding CategoryCaption, Mode=OneWay}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Foreground="#52606D" VerticalAlignment="Center" Margin="10,0,0,0"
                                       MaxWidth="220" TextTrimming="CharacterEllipsis"
                                       Text="{Binding ScopeCaption, Mode=OneWay}"/>
                            <TextBlock Grid.Column="3" Foreground="#52606D" VerticalAlignment="Center" Margin="16,0,0,0"
                                       MaxWidth="240" TextTrimming="CharacterEllipsis"
                                       Text="{Binding ReversalCaption, Mode=OneWay}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#1F2933" Margin="0,16,0,0"
                       Visibility="{Binding HasWarnings, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource locKey}">
                        <Binding Mode="OneWay" Source="Review.Warnings"/><Binding Mode="OneWay" Source="{StaticResource Loc}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,8,0,0"
                          Visibility="{Binding HasWarnings, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="#9B1C1C" FontSize="13" Margin="0,2" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Foreground="#2F855A" FontSize="13" Margin="0,8,0,0"
                       Visibility="{Binding HasWarnings, Mode=OneWay, Converter={StaticResource BoolToVisInv}}">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource locKey}">
                        <Binding Mode="OneWay" Source="Review.NoWarnings"/><Binding Mode="OneWay" Source="{StaticResource Loc}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <!-- Stage 12.2/12.3 blocker fix: explicit validation outcome. The old
                 flow gave no visible response at all — a successful validation
                 merely enabled Apply and a failed one kept showing
                 "没有校验警告" because HasWarnings was never notified. -->
            <TextBlock Foreground="#2F855A" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"
                       Visibility="{Binding ValidationPassed, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                       Text="{Binding ValidationMessage, Mode=OneWay}"/>
            <TextBlock Foreground="#9B1C1C" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"
                       Visibility="{Binding HasValidationFailure, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                       Text="{Binding ValidationMessage, Mode=OneWay}"/>

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Style="{StaticResource PrimaryButton}" Background="#487EB0" Command="{Binding ValidateCommand}">
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Mode="OneWay" Source="Review.Validate"/><Binding Mode="OneWay" Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Background="#2F855A" Margin="8,0,0,0" Command="{Binding ApplyCommand}">
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Mode="OneWay" Source="Review.Apply"/><Binding Mode="OneWay" Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Button>
            </StackPanel>

            <TextBlock FontSize="13" Foreground="#3B82F6" Margin="0,12,0,0" TextWrapping="Wrap"
                       Visibility="{Binding ProgressText, Mode=OneWay, Converter={StaticResource NullToVis}}"
                       Text="{Binding ProgressText, Mode=OneWay}"/>
            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#1F2933" Margin="0,8,0,0" TextWrapping="Wrap"
                       Visibility="{Binding ResultSummary, Mode=OneWay, Converter={StaticResource NullToVis}}"
                       Text="{Binding ResultSummary, Mode=OneWay}"/>

            <!-- Stage 12.6: failed apply operations are explicit and visible —
                 a partial apply is never silently treated as full success. -->
            <StackPanel Margin="0,12,0,0"
                        Visibility="{Binding HasFailedOperations, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left"
                        Cursor="Hand" Command="{Binding ToggleFailedItemsCommand, Mode=OneWay}">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#9B1C1C">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Mode="OneWay" Source="Apply.FailedItemsHeader"/><Binding Mode="OneWay" Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Button>
                <ItemsControl ItemsSource="{Binding FailedOperations, Mode=OneWay}" Margin="0,6,0,0"
                              Visibility="{Binding FailedItemsExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ReviewFailedOperationItem}">
                            <StackPanel Margin="0,3,0,0">
                                <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="#9B1C1C"
                                           Text="{Binding DisplayName, Mode=OneWay}"/>
                                <TextBlock FontSize="12" Foreground="#7B8794" TextWrapping="Wrap"
                                           Text="{Binding Reason, Mode=OneWay}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock FontSize="12" Foreground="#7B8794" Margin="0,16,0,0" TextWrapping="Wrap">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource locKey}">
                        <Binding Mode="OneWay" Source="Review.Note"/><Binding Mode="OneWay" Source="{StaticResource Loc}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
