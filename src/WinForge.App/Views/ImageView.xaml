<UserControl x:Class="WinForge.App.Views.ImageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:WinForge.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ImageViewModel}">
    <ScrollViewer Padding="32">
        <StackPanel MaxWidth="820">
            <TextBlock Text="Source Image" FontSize="24" FontWeight="Bold" Foreground="#1F2933"/>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <TextBox Text="{Binding FileDisplay, Mode=OneWay}" IsReadOnly="True" Width="440" Padding="8"
                         VerticalContentAlignment="Center" BorderBrush="#CBD2D9"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Select ISO"
                        Command="{Binding SelectIsoCommand}" Margin="8,0,0,0"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Inspect"
                        Command="{Binding InspectIsoCommand}" Margin="8,0,0,0"
                        Background="#487EB0"/>
            </StackPanel>

            <TextBlock Text="Inspection" FontSize="16" FontWeight="SemiBold" Foreground="#1F2933" Margin="0,24,0,0"/>

            <TextBlock Text="Inspecting ISO..." FontSize="13" Foreground="#3B82F6"
                       Margin="0,8,0,0" Visibility="{Binding IsInspecting, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#9B1C1C"
                       Margin="0,8,0,0" TextWrapping="Wrap"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>

            <StackPanel Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="File"/>
                    <TextBlock Text="{Binding FileDisplay}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="File name"/>
                    <TextBlock Text="{Binding FileNameDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Size"/>
                    <TextBlock Text="{Binding SizeDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Detection"/>
                    <TextBlock Text="{Binding DetectedTypeDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Install image"/>
                    <TextBlock Text="{Binding InstallImageDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Windows information" FontSize="16" FontWeight="SemiBold" Foreground="#1F2933" Margin="0,24,0,0"/>
            <StackPanel Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Windows Version"/>
                    <TextBlock Text="{Binding WindowsVersionDisplay}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Build"/>
                    <TextBlock Text="{Binding BuildDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Architecture"/>
                    <TextBlock Text="{Binding ArchitectureDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Language"/>
                    <TextBlock Text="{Binding LanguagesDisplay}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Editions" FontSize="16" FontWeight="SemiBold" Foreground="#1F2933" Margin="0,24,0,0"/>
            <ListView ItemsSource="{Binding Editions}"
                      SelectedItem="{Binding SelectedEdition, Mode=TwoWay}"
                      MaxHeight="340" Margin="0,8,0,0"
                      BorderBrush="#CBD2D9" BorderThickness="1">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4">
                            <TextBlock Text="{Binding Index}" FontWeight="SemiBold" Width="30"/>
                            <TextBlock Text="{Binding Name}" Width="260" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Architecture}" Foreground="#52606D"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Select an edition to target it for customization."
                       FontSize="12" Foreground="#7B8794" Margin="0,8,0,0" TextWrapping="Wrap"/>

            <TextBlock Text="Selected image" FontSize="16" FontWeight="SemiBold" Foreground="#1F2933" Margin="0,24,0,0"/>
            <StackPanel Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Status"/>
                    <TextBlock Text="{Binding WorkspaceStatusDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Edition"/>
                    <TextBlock Text="{Binding WorkspaceEditionDisplay}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Index"/>
                    <TextBlock Text="{Binding WorkspaceIndexDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Image"/>
                    <TextBlock Text="{Binding WorkspaceImageDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Architecture"/>
                    <TextBlock Text="{Binding WorkspaceArchitectureDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Build"/>
                    <TextBlock Text="{Binding WorkspaceBuildDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Source"/>
                    <TextBlock Text="{Binding WorkspaceSourceDisplay}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Text="The workspace references the original ISO and the image's path inside it — the temporary mount drive is never stored or shown."
                       FontSize="12" Foreground="#7B8794" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
