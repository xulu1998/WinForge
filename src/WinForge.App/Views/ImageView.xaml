<UserControl x:Class="WinForge.App.Views.ImageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:WinForge.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ImageViewModel}">
    <ScrollViewer Padding="32">
        <StackPanel MaxWidth="820">
            <TextBlock Text="Source Image" FontSize="24" FontWeight="Bold" Foreground="#1F2933"/>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <TextBox Text="{Binding FileDisplay, Mode=OneWay}" IsReadOnly="True" Width="440" Padding="8"
                         VerticalContentAlignment="Center" BorderBrush="#CBD2D9"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Select ISO"
                        Command="{Binding SelectIsoCommand}" Margin="8,0,0,0"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Inspect"
                        Command="{Binding InspectIsoCommand}" Margin="8,0,0,0"
                        Background="#487EB0"/>
            </StackPanel>

            <TextBlock Text="Inspection" FontSize="16" FontWeight="SemiBold" Foreground="#1F2933" Margin="0,24,0,0"/>

            <TextBlock Text="Inspecting ISO..." FontSize="13" Foreground="#3B82F6"
                       Margin="0,8,0,0" Visibility="{Binding IsInspecting, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#9B1C1C"
                       Margin="0,8,0,0" TextWrapping="Wrap"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>

            <StackPanel Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="File"/>
                    <TextBlock Text="{Binding FileDisplay}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="File name"/>
                    <TextBlock Text="{Binding FileNameDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Size"/>
                    <TextBlock Text="{Binding SizeDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Detection"/>
                    <TextBlock Text="{Binding DetectedTypeDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Install image"/>
                    <TextBlock Text="{Binding InstallImageDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Windows information" FontSize="16" FontWeight="SemiBold" Foreground="#1F2933" Margin="0,24,0,0"/>
            <StackPanel Margin="0,8,0,0">
                <!-- Phase 13: ONE compact compatibility row (status/safety signal).
                     Media-level facts show immediately after Detect, BEFORE an
                     edition is selected; selecting an edition refines the row. -->
                <StackPanel Orientation="Horizontal" Margin="0,4"
                            Visibility="{Binding HasCompatibilityProfile, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource FieldLabel}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Source="Compat.Label"/><Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding CompatibilityStatusText, Mode=OneWay}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock FontSize="12" Foreground="#B45309" Margin="76,0,0,0" TextWrapping="Wrap"
                           Text="{Binding CompatibilityWarningsText, Mode=OneWay}"
                           Visibility="{Binding HasCompatibilityWarnings, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                <TextBlock FontSize="12" Foreground="#9B1C1C" Margin="76,0,0,0" TextWrapping="Wrap"
                           Text="{Binding CompatibilityBlockersText, Mode=OneWay}"
                           Visibility="{Binding HasCompatibilityBlockers, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="PHASE13-COMPAT-DIAG · 9f4bed0" FontSize="11" Foreground="#B45309" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding CompatibilityDebugText, Mode=OneWay}" FontSize="11" Foreground="#7B8794" Margin="0,2,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Windows Version"/>
                    <TextBlock Text="{Binding WindowsVersionDisplay}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Build"/>
                    <TextBlock Text="{Binding BuildDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Architecture"/>
                    <TextBlock Text="{Binding ArchitectureDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Language"/>
                    <TextBlock Text="{Binding LanguagesDisplay}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Editions" FontSize="16" FontWeight="SemiBold" Foreground="#1F2933" Margin="0,24,0,0"/>
            <ListView ItemsSource="{Binding Editions}"
                      SelectedItem="{Binding SelectedEdition, Mode=TwoWay}"
                      MaxHeight="340" Margin="0,8,0,0"
                      BorderBrush="#CBD2D9" BorderThickness="1">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4">
                            <TextBlock Text="{Binding Index}" FontWeight="SemiBold" Width="30"/>
                            <TextBlock Text="{Binding Name}" Width="260" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Architecture}" Foreground="#52606D"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Select an edition to target it for customization."
                       FontSize="12" Foreground="#7B8794" Margin="0,8,0,0" TextWrapping="Wrap"/>

            <TextBlock Text="Selected image" FontSize="16" FontWeight="SemiBold" Foreground="#1F2933" Margin="0,24,0,0"/>
            <StackPanel Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Status"/>
                    <TextBlock Text="{Binding WorkspaceStatusDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Edition"/>
                    <TextBlock Text="{Binding WorkspaceEditionDisplay}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Index"/>
                    <TextBlock Text="{Binding WorkspaceIndexDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Image"/>
                    <TextBlock Text="{Binding WorkspaceImageDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Architecture"/>
                    <TextBlock Text="{Binding WorkspaceArchitectureDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Build"/>
                    <TextBlock Text="{Binding WorkspaceBuildDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Source"/>
                    <TextBlock Text="{Binding WorkspaceSourceDisplay}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Text="The workspace references the original ISO and the image's path inside it — the temporary mount drive is never stored or shown."
                       FontSize="12" Foreground="#7B8794" Margin="0,8,0,0" TextWrapping="Wrap"/>

            <TextBlock Text="Working image" FontSize="16" FontWeight="SemiBold" Foreground="#1F2933" Margin="0,24,0,0"/>
            <TextBlock Text="WinForge works on an isolated copy of the selected Windows edition. The original ISO and install.wim/install.esd are never modified."
                       FontSize="12" Foreground="#7B8794" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Style="{StaticResource PrimaryButton}" Content="Prepare working image"
                        Command="{Binding PrepareWorkingImageCommand}" Margin="0,0,8,0"
                        Background="#2F855A"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Mount image"
                        Command="{Binding MountWorkingImageCommand}" Margin="0,0,8,0"
                        Background="#487EB0"
                        Visibility="{Binding CanMountWorkingImage, Converter={StaticResource BoolToVis}}"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Unmount &amp; discard changes"
                        Command="{Binding UnmountDiscardCommand}" Margin="0,0,8,0"
                        Background="#9B1C1C"
                        Visibility="{Binding CanUnmountDiscard, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <TextBlock Text="{Binding ServicingMessage}" FontSize="13" Foreground="#3B82F6"
                       Margin="0,8,0,0" TextWrapping="Wrap"
                       Visibility="{Binding IsServicing, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding BlockedMessage}" FontSize="13" Foreground="#9B1C1C"
                       Margin="0,8,0,0" TextWrapping="Wrap"
                       Visibility="{Binding BlockedMessage, Converter={StaticResource NullToVis}}"/>

            <StackPanel Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Status"/>
                    <TextBlock Text="{Binding ServicingStatusDisplay}" FontSize="13" VerticalAlignment="Center"
                               FontWeight="{Binding IsServicingMounted, Converter={StaticResource BoolToBold}}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Source edition"/>
                    <TextBlock Text="{Binding ServicingSourceEditionDisplay}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Source index"/>
                    <TextBlock Text="{Binding ServicingSourceIndexDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Working image"/>
                    <TextBlock Text="{Binding ServicingWorkingImageDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Working index"/>
                    <TextBlock Text="{Binding ServicingWorkingIndexDisplay}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Working directory"/>
                    <TextBlock Text="{Binding ServicingWorkingDirectoryDisplay}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Mount directory"/>
                    <TextBlock Text="{Binding ServicingMountDirectoryDisplay}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Text="{Binding ServicingErrorDisplay}" FontSize="12" Foreground="#9B1C1C"
                           Margin="0,4,0,0" TextWrapping="Wrap"
                           Visibility="{Binding ServicingErrorDisplay, Converter={StaticResource NullToVis}}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
