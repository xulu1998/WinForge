<UserControl x:Class="WinForge.App.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:WinForge.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ProfileViewModel}">
    <Border Background="#F5F7FA" BorderBrush="#E4E7EB" BorderThickness="1" CornerRadius="6"
            Padding="12,8" Margin="0,10,0,0">
        <StackPanel>
            <!-- Compact profile cards: one row, name + very short subtitle (UX fix) -->
            <ItemsControl ItemsSource="{Binding Profiles, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ProfileItemViewModel}">
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  VerticalAlignment="Top" Margin="0,0,8,0"
                                  ToolTip="{Binding Description, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Margin="2,0,6,0">
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#1F2933"
                                           Text="{Binding DisplayName, Mode=OneWay}"/>
                                <TextBlock FontSize="11" Foreground="#7B8794" Margin="8,2,0,0"
                                           Text="{Binding Description, Mode=OneWay}"/>
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Compact summary + primary action row -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                        Visibility="{Binding HasActiveProfiles, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#1F2933" VerticalAlignment="Center"
                           Text="{Binding ActiveProfileCaption, Mode=OneWay}"/>
                <TextBlock FontSize="12" Foreground="#3E4C59" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Run Text="{Binding TrimCount, Mode=OneWay}"/><Run Text=" "/>
                    <Run Text="{Binding SummaryAdoptLabel, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock FontSize="12" Foreground="#3E4C59" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Run Text="{Binding KeepCount, Mode=OneWay}"/><Run Text=" "/>
                    <Run Text="{Binding SummaryKeepLabel, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock FontSize="12" Foreground="#3E4C59" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Run Text="{Binding ManualCount, Mode=OneWay}"/><Run Text=" "/>
                    <Run Text="{Binding SummaryConfirmLabel, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock FontSize="12" Foreground="#B45309" Margin="12,0,0,0" VerticalAlignment="Center"
                           Visibility="{Binding HasConflicts, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <Run Text="{Binding ConflictCount, Mode=OneWay}"/><Run Text=" "/>
                    <Run Text="{Binding SummaryConflictLabel, Mode=OneWay}"/>
                </TextBlock>

                <Button Style="{StaticResource PrimaryButton}" Background="#2F855A" Margin="18,0,0,0"
                        Command="{Binding AdoptCommand, Mode=OneWay}">
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Source="Profile.Adopt"/><Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Button>
                <!-- Conditional reapply (only after adoption + divergence) -->
                <Button Margin="8,0,0,0" Padding="10,6" Background="White" BorderBrush="#CBD2D9"
                        BorderThickness="1" FontSize="12" Foreground="#1F2933" VerticalAlignment="Center"
                        Command="{Binding ReapplyCommand, Mode=OneWay}"
                        Visibility="{Binding ReapplyVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Source="Profile.Reapply"/><Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Button>
                <!-- Demoted preview: lightweight secondary action, not a competing primary -->
                <Button Margin="8,0,0,0" Padding="10,6" Background="Transparent" BorderThickness="0"
                        FontSize="12" Foreground="#3B82F6" VerticalAlignment="Center"
                        Command="{Binding ShowPreviewCommand, Mode=OneWay}">
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}">
                                <Binding Source="Profile.Details"/><Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Button>
            </StackPanel>

            <!-- Manual-mode / Custom caption when no preset profile drives recommendations -->
            <TextBlock FontSize="12" Foreground="#7B8794" Margin="0,6,0,0"
                       Text="{Binding ActiveProfileCaption, Mode=OneWay}"
                       Visibility="{Binding HasActiveProfiles, Mode=OneWay, Converter={StaticResource BoolToVisInv}}"/>

            <!-- Preview panel (Part I) — non-destructive, shows what WOULD be selected -->
            <StackPanel Margin="0,10,0,0"
                        Visibility="{Binding IsPreviewOpen, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding PreviewGroups, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RecommendationPreviewGroup}">
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#1F2933">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource locKey}">
                                            <Binding Path="HeaderKey" Mode="OneWay"/><Binding Source="{StaticResource Loc}" Mode="OneWay"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Items, Mode=OneWay}" Margin="12,2,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:RecommendationPreviewItem}">
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock FontSize="12" Foreground="#1F2933"
                                                           Text="{Binding DisplayName, Mode=OneWay}" MinWidth="240"/>
                                                <TextBlock FontSize="12" Foreground="#2F855A"
                                                           Text="{Binding Caption, Mode=OneWay}" MinWidth="110"/>
                                                <TextBlock FontSize="11" Foreground="#7B8794" TextWrapping="Wrap"
                                                           MaxWidth="480" Text="{Binding ReasonText, Mode=OneWay}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
