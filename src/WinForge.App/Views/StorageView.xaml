<UserControl x:Class="WinForge.App.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:WinForge.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:StorageViewModel}">
    <StackPanel Margin="0,20,0,0">
        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#1F2933">
            <TextBlock.Text>
                <MultiBinding Converter="{StaticResource locKey}">
                    <Binding Source="Storage.Title"/><Binding Source="{StaticResource Loc}"/>
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
        <TextBlock FontSize="11.5" Foreground="#7B8794" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="760">
            <TextBlock.Text>
                <MultiBinding Converter="{StaticResource locKey}">
                    <Binding Source="Storage.Description"/><Binding Source="{StaticResource Loc}"/>
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>

        <!-- Stage 12.2: workspace root (Part A/F) -->
        <Border Background="#F5F7FA" BorderBrush="#E4E7EB" BorderThickness="1" CornerRadius="6"
                Padding="12,8" Margin="0,14,0,0" MaxWidth="760" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#1F2933">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource locKey}">
                            <Binding Source="Storage.Root.Title"/><Binding Source="{StaticResource Loc}"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock FontSize="12" Foreground="#3E4C59" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="{Binding CurrentRootText, Mode=OneWay}"/>
                <TextBlock FontSize="11.5" Foreground="#7B8794" Margin="0,2,0,0"
                           Text="{Binding RootFreeSpaceText, Mode=OneWay}"/>
                <TextBlock FontSize="11.5" Foreground="#B45309" Margin="0,2,0,0"
                           Text="{Binding RootLowSpaceWarningText, Mode=OneWay}"
                           Visibility="{Binding RootLowSpaceWarning, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                <TextBlock FontSize="11.5" Foreground="#9A3412" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="{Binding RootErrorText, Mode=OneWay}"
                           Visibility="{Binding RootErrorText, Mode=OneWay, Converter={StaticResource NullEmptyToVis}}"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Background="#2F855A" Foreground="White" BorderThickness="0" Padding="10,5" FontSize="12"
                            Command="{Binding ChangeRootCommand, Mode=OneWay}">
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource locKey}">
                                    <Binding Source="Storage.Root.Change"/><Binding Source="{StaticResource Loc}"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Button>
                    <Button Margin="8,0,0,0" Padding="10,5" Background="Transparent" BorderThickness="0" FontSize="12"
                            Foreground="#3B82F6" Command="{Binding RestoreDefaultCommand, Mode=OneWay}">
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource locKey}">
                                    <Binding Source="Storage.Root.Restore"/><Binding Source="{StaticResource Loc}"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Style="{StaticResource PrimaryButton}" Background="#2F855A" Padding="12,6"
                    Command="{Binding ScanCommand, Mode=OneWay}"
                    IsEnabled="{Binding IsScanning, Mode=OneWay, Converter={StaticResource BoolToVisInv}}">
                <TextBlock>
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource locKey}">
                            <Binding Source="Storage.Scan"/><Binding Source="{StaticResource Loc}"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Button>
            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#3B82F6" FontSize="12"
                       Visibility="{Binding IsScanning, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource locKey}">
                        <Binding Source="Storage.Scanning"/><Binding Source="{StaticResource Loc}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </StackPanel>

        <!-- Summary numbers -->
        <StackPanel Orientation="Horizontal" Margin="0,14,0,0"
                    Visibility="{Binding HasScanned, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#1F2933" VerticalAlignment="Center"
                       Text="{Binding TotalBytesText, Mode=OneWay}"/>
            <TextBlock FontSize="12" Foreground="#3E4C59" Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource locKey}">
                        <Binding Source="Storage.TotalTemporary"/><Binding Source="{StaticResource Loc}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                    Visibility="{Binding HasScanned, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <!-- Stage 12.2 fix: single formatted string from the view model.
                 The previous Run-inline composed list threw a
                 'System.Windows.Documents.Run Text' property exception on the real
                 desktop when the inlines were materialized during layout of the
                 previously-collapsed TextBlock. No Run/Inline remains here. -->
            <TextBlock FontSize="12" Foreground="#3E4C59"
                       Text="{Binding UsageSummaryText, Mode=OneWay}"/>
        </StackPanel>

        <!-- Cleanup preview -->
        <StackPanel Margin="0,14,0,0"
                    Visibility="{Binding HasCandidates, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#1F2933">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource locKey}">
                        <Binding Source="Storage.SafeToClean"/><Binding Source="{StaticResource Loc}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding CleanupCandidates, Mode=OneWay}" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:StorageCandidateItem}">
                        <StackPanel Margin="0,2,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="12" Foreground="#1F2933" Width="150" TextTrimming="CharacterEllipsis"
                                           Text="{Binding WorkspaceId, Mode=OneWay}"/>
                                <TextBlock FontSize="12" Foreground="#2F855A" Width="90"
                                           Text="{Binding SizeText, Mode=OneWay}"/>
                                <TextBlock FontSize="11" Foreground="#9A3412" Margin="8,0,0,0"
                                           Visibility="{Binding IsLegacy, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource locKey}">
                                            <Binding Source="Storage.Legacy"/><Binding Source="{StaticResource Loc}"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <!-- Stage 12.7: each candidate shows its OWNING root so
                                 the size is never mistaken for the current F: root. -->
                            <TextBlock FontSize="10.5" Foreground="#9AA5B1" Margin="0,1,0,0"
                                       Text="{Binding RootPath, Mode=OneWay}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock FontSize="11.5" Foreground="#7B8794" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="760">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource locKey}">
                        <Binding Source="Storage.WillKeep"/><Binding Source="{StaticResource Loc}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <Button Style="{StaticResource PrimaryButton}" Background="#B45309" Margin="0,10,0,0" Padding="12,6"
                    Command="{Binding CleanCommand, Mode=OneWay}"
                    IsEnabled="{Binding IsCleaning, Mode=OneWay, Converter={StaticResource BoolToVisInv}}">
                <TextBlock>
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource locKey}">
                            <Binding Source="Storage.Clean"/><Binding Source="{StaticResource Loc}"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Button>
            <TextBlock FontSize="12" Foreground="#2F855A" Margin="0,8,0,0"
                       Text="{Binding CleanResultText, Mode=OneWay}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
