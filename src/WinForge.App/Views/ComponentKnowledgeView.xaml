<UserControl x:Class="WinForge.App.Views.ComponentKnowledgeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:WinForge.App.ViewModels"
             xmlns:conv="clr-namespace:WinForge.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ComponentKnowledgeViewModel}">
    <UserControl.Resources>
        <DataTemplate x:Key="KnowledgeDetailTemplate" DataType="{x:Type vm:ComponentKnowledgeItem}">
            <Border BorderBrush="#CBD2D9" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,10,0,0"
                    Background="#F8FAFC">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock FontSize="16" FontWeight="Bold" Text="{Binding DisplayName}"/>
                        <Button Margin="10,0,0,0" Command="{Binding DataContext.ClearDetailCommand,
                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Content="✕"/>
                    </StackPanel>

                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Text="{Binding ShortPurpose}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Background="{Binding RecommendationLevel, Converter={StaticResource recColor}}"
                                Padding="8,3" CornerRadius="4" Margin="0,0,6,0">
                            <TextBlock Foreground="White" FontSize="12">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource locKey}" Mode="OneWay">
                                        <Binding Source="Component.Recommendation"/><Binding Source="{StaticResource Loc}"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Border>
                        <Border Background="{Binding RiskLevel, Converter={StaticResource riskColor}}"
                                Padding="8,3" CornerRadius="4">
                            <TextBlock Foreground="White" FontSize="12">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource locKey}" Mode="OneWay">
                                        <Binding Source="Component.Risk"/><Binding Source="{StaticResource Loc}"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!-- Block reason: shown ONLY for components that cannot be removed
                         (NeverRemove / Critical / Blocked). Selectable rows have an
                         empty reason and stay collapsed (keeps the row to 5 columns). -->
                    <TextBlock Margin="0,0,0,6" Foreground="#9B1C1C" FontWeight="SemiBold"
                               Text="{Binding BlockReason}"
                               Visibility="{Binding BlockReason, Mode=OneWay,
                               Converter={StaticResource NullEmptyToVis}}"/>

                    <!-- Why is this recommended? (deterministic, curated) -->
                    <TextBlock FontWeight="SemiBold" Margin="0,4,0,2">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}" Mode="OneWay">
                                <Binding Source="Knowledge.WhyRecommended"/><Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding WhyPoints}" Margin="0,0,0,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,2" Text="{Binding Path=.}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource locKey}" Mode="OneWay">
                                    <Binding Source="Component.KeepIf"/><Binding Source="{StaticResource Loc}"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Text="{Binding KeepIfText}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource locKey}" Mode="OneWay">
                                    <Binding Source="Component.RemoveIf"/><Binding Source="{StaticResource Loc}"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Text="{Binding RemoveIfText}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource locKey}" Mode="OneWay">
                                    <Binding Source="Component.Impact"/><Binding Source="{StaticResource Loc}"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Text="{Binding ImpactText}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource locKey}" Mode="OneWay">
                                    <Binding Source="Component.Restoration"/><Binding Source="{StaticResource Loc}"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" Text="{Binding RestoreCaption}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource locKey}" Mode="OneWay">
                                    <Binding Source="Component.Scenarios"/><Binding Source="{StaticResource Loc}"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <ItemsControl Grid.Row="4" Grid.Column="1" ItemsSource="{Binding Scenarios}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Path=.}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource locKey}" Mode="OneWay">
                                    <Binding Source="Component.Dependencies"/><Binding Source="{StaticResource Loc}"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <ItemsControl Grid.Row="5" Grid.Column="1" ItemsSource="{Binding Dependencies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" Text="{Binding Path=.}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- Evidence / provenance (official vs community distinct) -->
                    <TextBlock FontWeight="SemiBold" Margin="0,8,0,2">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}" Mode="OneWay">
                                <Binding Source="Component.Evidence"/><Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding OfficialEvidence}" Margin="0,0,0,2">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path=.}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding CommunityEvidence}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="#9B1C1C" Text="{Binding Path=.}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Collapsed technical identities -->
                    <TextBlock FontWeight="SemiBold" Margin="0,8,0,2">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource locKey}" Mode="OneWay">
                                <Binding Source="Component.TechnicalDetails"/><Binding Source="{StaticResource Loc}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding RawIdentities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="Consolas" FontSize="11" Text="{Binding Path=.}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <!-- Discovery is unified at the Customize step level (one button, one
                     coherent read-only pass) — there is no separate in-tab Discover
                     button here (ADR-049). Only the recommendation filter remains. -->
                <ComboBox Width="170" VerticalAlignment="Center"
                          ItemsSource="{Binding FilterOptions}" SelectedValuePath="Value"
                          SelectedValue="{Binding Filter, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource locKey}" Mode="OneWay">
                                        <Binding Path="Caption"/><Binding Source="{StaticResource Loc}"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <TextBlock FontSize="11" Foreground="#7B8794" Margin="0,6,0,0" TextWrapping="Wrap">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource locKey}" Mode="OneWay">
                        <Binding Source="Knowledge.SortNote"/><Binding Source="{StaticResource Loc}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Primary decision list occupies the main content area (never squeezed). -->
            <Grid Grid.Column="0">
            <ListView ItemsSource="{Binding Items}" BorderBrush="#CBD2D9" BorderThickness="1"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      MouseLeftButtonUp="OnRowMouseLeftButtonUp"
                      KeyDown="OnRowKeyDown"
                      VirtualizingStackPanel.IsVirtualizing="False">
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ComponentKnowledgeItem}">
                        <Border BorderBrush="#E4E7EB" BorderThickness="0,0,0,1" Padding="6" Margin="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <!-- "Currently being inspected" highlight — distinct from the
                                             checkbox's own (removal) checked visual. -->
                                        <DataTrigger Binding="{Binding IsActiveDetail}" Value="True">
                                            <Setter Property="Background" Value="#E8F0FE"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.ToolTip>
                                <StackPanel MaxWidth="340">
                                    <TextBlock FontWeight="Bold" Text="{Binding DisplayName}"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,2,0,0" Text="{Binding ShortPurpose}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock FontWeight="SemiBold" Margin="0,0,4,0">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource locKey}" Mode="OneWay">
                                                    <Binding Source="Component.Recommendation"/><Binding Source="{StaticResource Loc}"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="{Binding RecommendationCaption}"/>
                                        <TextBlock FontWeight="SemiBold" Margin="10,0,4,0">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource locKey}" Mode="OneWay">
                                                    <Binding Source="Component.Risk"/><Binding Source="{StaticResource Loc}"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="{Binding RiskCaption}"/>
                                    </StackPanel>
                                    <TextBlock Margin="0,4,0,0">
                                        <Run Text="{Binding KeepIfText, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="{Binding RemoveIfText, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="{Binding ImpactText, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="{Binding RestoreCaption, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border.ToolTip>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsSelectable}"
                                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Width="170" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           FontWeight="SemiBold" Text="{Binding DisplayName}"/>
                                <TextBlock Width="220" TextTrimming="CharacterEllipsis" Foreground="#52606D"
                                           VerticalAlignment="Center" Text="{Binding ShortPurpose}"/>
                                <Border Background="{Binding RecommendationLevel, Converter={StaticResource recColor}}"
                                        Padding="6,2" CornerRadius="3" Margin="6,0" VerticalAlignment="Center">
                                    <TextBlock Foreground="White" FontSize="11" Text="{Binding RecommendationCaption}"/>
                                </Border>
                                <Border Background="{Binding RiskLevel, Converter={StaticResource riskColor}}"
                                        Padding="6,2" CornerRadius="3" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Foreground="White" FontSize="11" Text="{Binding RiskCaption}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

                <!-- Empty state: shown ONLY when there are no rows (never an empty detail card). -->
                <Border Background="#F8FAFC" BorderBrush="#CBD2D9" BorderThickness="1" CornerRadius="6"
                        Padding="24" Visibility="{Binding IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <TextBlock FontSize="14" Foreground="#3E4C59" TextWrapping="Wrap" HorizontalAlignment="Center"
                               Text="{Binding EmptyStateText}"/>
                </Border>
            </Grid>

            <!-- Secondary detail side panel: fully collapsed when no detail is selected, so it
                 can never squeeze the list to zero height. Opens via ⓘ, closes via ✕. -->
            <ContentControl Grid.Column="1" Content="{Binding ActiveDetail, Mode=OneWay}"
                            ContentTemplate="{StaticResource KnowledgeDetailTemplate}"
                            Visibility="{Binding ActiveDetail, Mode=OneWay, Converter={StaticResource NullToVis}}"
                            Width="400" Margin="12,0,0,0" VerticalAlignment="Stretch"/>
        </Grid>
    </DockPanel>
</UserControl>
