  <data name="Comp.Weather.DisplayName" xml:space="preserve"><value>Microsoft Weather</value></data>
  <data name="Comp.Weather.Short" xml:space="preserve"><value>Microsoft's weather application, provisioned for new users.</value></data>
  <data name="Comp.Weather.Long" xml:space="preserve"><value>The built-in Weather app. Its removal only affects the app itself; it does not disable Windows networking or any weather APIs used by the OS.</value></data>
  <data name="Comp.Weather.KeepIf" xml:space="preserve"><value>You actively use the Microsoft Weather app.</value></data>
  <data name="Comp.Weather.RemoveIf" xml:space="preserve"><value>You never check weather in the built-in app and use a website or another app.</value></data>
  <data name="Comp.Weather.Impact" xml:space="preserve"><value>The Weather app is unavailable for newly created users. No core Windows feature is removed.</value></data>
  <data name="Comp.Clipchamp.DisplayName" xml:space="preserve"><value>Clipchamp</value></data>
  <data name="Comp.Clipchamp.Short" xml:space="preserve"><value>Microsoft's video editor, provisioned for new users.</value></data>
  <data name="Comp.Clipchamp.Long" xml:space="preserve"><value>A consumer video-editing and capture tool. Removal only affects the app; it is reinstallable from the Microsoft Store.</value></data>
  <data name="Comp.Clipchamp.KeepIf" xml:space="preserve"><value>You edit or record video with Clipchamp.</value></data>
  <data name="Comp.Clipchamp.RemoveIf" xml:space="preserve"><value>You never use Clipchamp and prefer another editor.</value></data>
  <data name="Comp.Clipchamp.Impact" xml:space="preserve"><value>Clipchamp is unavailable for new users. No system video capability is removed.</value></data>
  <data name="Comp.GetHelp.DisplayName" xml:space="preserve"><value>Get Help</value></data>
  <data name="Comp.GetHelp.Short" xml:space="preserve"><value>Microsoft's help viewer / contact-support app.</value></data>
  <data name="Comp.GetHelp.Long" xml:space="preserve"><value>Launches help articles and can open a support contact flow. Removing it does not disable Windows troubleshooting or Settings search.</value></data>
  <data name="Comp.GetHelp.KeepIf" xml:space="preserve"><value>You use the built-in Help app to reach Microsoft support.</value></data>
  <data name="Comp.GetHelp.RemoveIf" xml:space="preserve"><value>You never use the Help app and search the web instead.</value></data>
  <data name="Comp.GetHelp.Impact" xml:space="preserve"><value>The Get Help app is unavailable. Windows Settings and troubleshooting remain.</value></data>
  <data name="Comp.XboxApp.DisplayName" xml:space="preserve"><value>Xbox</value></data>
  <data name="Comp.XboxApp.Short" xml:space="preserve"><value>Xbox app and related gaming overlays/providers.</value></data>
  <data name="Comp.XboxApp.Long" xml:space="preserve"><value>The Xbox app plus its gaming overlay and identity provider. Relevant to Xbox Game Pass and PC gaming. Removal is safe for users who do not game on Xbox.</value></data>
  <data name="Comp.XboxApp.KeepIf" xml:space="preserve"><value>You use Xbox Game Pass or play Xbox titles on this PC.</value></data>
  <data name="Comp.XboxApp.RemoveIf" xml:space="preserve"><value>You do not use Xbox apps or PC gaming.</value></data>
  <data name="Comp.XboxApp.Impact" xml:space="preserve"><value>Xbox app, game overlay and Xbox sign-in provider are removed. Non-gaming apps are unaffected.</value></data>
  <data name="Comp.Photos.DisplayName" xml:space="preserve"><value>Photos</value></data>
  <data name="Comp.Photos.Short" xml:space="preserve"><value>Microsoft's default photo viewer/editor.</value></data>
  <data name="Comp.Photos.Long" xml:space="preserve"><value>The default Photos app. Many users rely on it as the shell image viewer; removing it leaves the OS without a built-in photo viewer (files still open via other apps).</value></data>
  <data name="Comp.Photos.KeepIf" xml:space="preserve"><value>You use Photos as your default image viewer.</value></data>
  <data name="Comp.Photos.RemoveIf" xml:space="preserve"><value>You use a different photo app and never the built-in one.</value></data>
  <data name="Comp.Photos.Impact" xml:space="preserve"><value>The built-in Photos viewer is removed. Image files remain on disk and open via other apps.</value></data>
  <data name="Comp.FeedbackHub.DisplayName" xml:space="preserve"><value>Feedback Hub</value></data>
  <data name="Comp.FeedbackHub.Short" xml:space="preserve"><value>Microsoft's Windows feedback app.</value></data>
  <data name="Comp.FeedbackHub.Long" xml:space="preserve"><value>Used to send feedback to Microsoft. Not required by any Windows feature.</value></data>
  <data name="Comp.FeedbackHub.KeepIf" xml:space="preserve"><value>You submit feedback to Microsoft through the app.</value></data>
  <data name="Comp.FeedbackHub.RemoveIf" xml:space="preserve"><value>You never use the Feedback Hub.</value></data>
  <data name="Comp.FeedbackHub.Impact" xml:space="preserve"><value>The Feedback Hub is unavailable. No Windows function depends on it.</value></data>
  <data name="Comp.Maps.DisplayName" xml:space="preserve"><value>Maps</value></data>
  <data name="Comp.Maps.Short" xml:space="preserve"><value>Microsoft's Maps application.</value></data>
  <data name="Comp.Maps.Long" xml:space="preserve"><value>The built-in Maps app. Offline maps and location APIs used by other apps are separate Windows features and are NOT removed with this app.</value></data>
  <data name="Comp.Maps.KeepIf" xml:space="preserve"><value>You use the built-in Maps app for navigation.</value></data>
  <data name="Comp.Maps.RemoveIf" xml:space="preserve"><value>You use a web map or another maps app.</value></data>
  <data name="Comp.Maps.Impact" xml:space="preserve"><value>The Maps app is removed. Location services and other apps' maps still work.</value></data>
  <data name="Comp.PhoneLink.DisplayName" xml:space="preserve"><value>Phone Link</value></data>
  <data name="Comp.PhoneLink.Short" xml:space="preserve"><value>Microsoft's app that links your phone to your PC.</value></data>
  <data name="Comp.PhoneLink.Long" xml:space="preserve"><value>Phone Link (Your Phone) mirrors notifications, photos and calls from an Android phone. Removing it only affects that integration.</value></data>
  <data name="Comp.PhoneLink.KeepIf" xml:space="preserve"><value>You use Phone Link to connect an Android phone.</value></data>
  <data name="Comp.PhoneLink.RemoveIf" xml:space="preserve"><value>You do not link a phone to this PC.</value></data>
  <data name="Comp.PhoneLink.Impact" xml:space="preserve"><value>Phone Link integration is removed. Your phone and PC otherwise work normally.</value></data>
  <data name="Comp.Solitaire.DisplayName" xml:space="preserve"><value>Solitaire Collection</value></data>
  <data name="Comp.Solitaire.Short" xml:space="preserve"><value>Microsoft's Solitaire / Casual Games app.</value></data>
  <data name="Comp.Solitaire.Long" xml:space="preserve"><value>A casual games bundle. Purely optional entertainment; no system dependency.</value></data>
  <data name="Comp.Solitaire.KeepIf" xml:space="preserve"><value>You play the built-in Solitaire or casual games.</value></data>
  <data name="Comp.Solitaire.RemoveIf" xml:space="preserve"><value>You never play the bundled games.</value></data>
  <data name="Comp.Solitaire.Impact" xml:space="preserve"><value>The Solitaire Collection is removed. No Windows function depends on it.</value></data>
  <data name="Comp.Teams.DisplayName" xml:space="preserve"><value>Microsoft Teams</value></data>
  <data name="Comp.Teams.Short" xml:space="preserve"><value>Microsoft's consumer/work chat and meetings app.</value></data>
  <data name="Comp.Teams.Long" xml:space="preserve"><value>Teams for personal and work communication. Files shared in Teams are stored in OneDrive; see the dependency note before removing OneDrive.</value></data>
  <data name="Comp.Teams.KeepIf" xml:space="preserve"><value>You use Teams for chat, calls or meetings.</value></data>
  <data name="Comp.Teams.RemoveIf" xml:space="preserve"><value>You do not use Teams on this PC.</value></data>
  <data name="Comp.Teams.Impact" xml:space="preserve"><value>The Teams app is removed. Web Teams still works in a browser.</value></data>
  <data name="Comp.OneDrive.DisplayName" xml:space="preserve"><value>OneDrive</value></data>
  <data name="Comp.OneDrive.Short" xml:space="preserve"><value>Microsoft's file-sync client.</value></data>
  <data name="Comp.OneDrive.Long" xml:space="preserve"><value>OneDrive syncs your files to the cloud and is deeply integrated with Office and the shell. Removal is possible but can affect file sync and Teams/Office storage; treat as Conditional and verify before removing.</value></data>
  <data name="Comp.OneDrive.KeepIf" xml:space="preserve"><value>You rely on OneDrive to sync or back up your files.</value></data>
  <data name="Comp.OneDrive.RemoveIf" xml:space="preserve"><value>You do not use cloud file sync and keep files local only.</value></data>
  <data name="Comp.OneDrive.Impact" xml:space="preserve"><value>OneDrive sync stops; locally cached files may need re-downloading. Office and shell integration are reduced.</value></data>

